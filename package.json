  },
  "author": "D1a0y1bb",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token",
    "usage",
    "dashboard",
    "settings"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test 'test/*.test.js'"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
